#!/bin/sh
#
# dummy xdg-open dependency script;
#
# SEE ALSO
# 1. `~/dotfiles.git/tmux/.tmux/plugins/tmux-open`

# IMPORTANT(JEFF): We must override the local search path here
# to ensure that we do not accidentally create a recursive
# process bomb; if we already have $HOME/local/bin and friends
# setup, this sets the stage for it.
PATH=/usr/bin:/usr/local/bin:/bin
xdg_open="$(which xdg-open)"

if [ -e "$xdg_open" ]; then
  [ -n "$DEBUG" ] && echo "$xdg_open" "$@"
  "$xdg_open" "$@"
else
  return 0
fi

