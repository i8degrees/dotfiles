# ~/.curlrc:jeff
#
# man 5 curl

# Homebrew; MacOS && Linux
#capath = /usr/local/etc/ssl/certs

# standardized search paths; these paths do 
# not exist on Android OS :-/
#capath = /etc/ssl/certs
#cacert = /etc/ssl/certs/ca-certificates.crt

# Google Chrome v134.0.6998.166
#
# 1. https://www.useragentstring.com/Chrome134.0.6998.166_id_20018.php
user-agent = "Mozilla/5.0 (Windows NT 11.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/134.0.6998.166 Safari/537.36"

#capath = /etc/ca-certificates/trust-source/anchors
# Arch / Manjaro Linux
#capath = /usr/share/ca-certificates/trust-source/anchors
# Debian
#capath = /usr/local/share/ca-certificates
# Homebrew; MacOS && Linux
#capath = /usr/local/etc/ssl/certs
# standardized search paths
#/etc/ssl/certs:
#/etc/ssl/certs/ca-certificates.crt

