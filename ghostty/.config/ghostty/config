# ~/.config/ghostty/config:jeff
#
# user ghostty configuration
#
# SEE ALSO
# 1. https://ghostty.org/docs/config
#
# Comments start with a `#` and are only valid on their own line;
# Empty values reset the configuration to the default value;
# Blank lines are ignored!
#
# QUICK REFERENCE
# 2. ghostty +validate-config
# 3. ghostty +show-config
#
# systemd on Linux
#
# 1. systemctl enable --user app-com.mitchellh.ghostty.service
# 1. systemctl reload --user app-com.mitchellh.ghostty.service
# 1. journalctl -a -f --user -u app-com.mitchellh.ghostty.service
# 1. systemctl status --user app-com.mitchellh.ghostty.service
#

auto-update = off

#background = 282c34
#foreground = ffffff

keybind = cmd+w=close_surface
# FIXME(JEFF): Invalid syntax?
#keybind = cmd+shit+o=new_split:down
#keybind = cmd+t=

font-family = "JetBrains Mono"
#font-family = "Source Code Pro"
bold-is-bright = true

#command = /bin/bash
# TODO
#command = /bin/bash ~/local/bin/tmux_init.sh default /home/jeff/Projects
# IMPORTANT(JEFF): The script we pass here must comply with the semantics of Ghostty;
# `/bin/sh -c $SHELL --posix`
#initial-command = ~/local/bin/tmux_init.sh default /home/jeff/Projects
# This is primarily useful for scripts or debugging.
#wait-after-command = true

shell-integration = bash
shell-integration-features = cursor,sudo,title

working-directory = home
# Always keep our window manager's decorations so we have access
# to its window functions menu!
window-decoration = true

# optimizations for using ghostty with systemd on Linux
# https://ghostty.org/docs/linux/systemd
quit-after-last-window-closed = false
quit-after-last-window-closed-delay = 30s

# v1.2.x
#gtk-titlebar-style=tabs
# TODO(JEFF): Verify and setup
#quick-terminal-size=480x640
