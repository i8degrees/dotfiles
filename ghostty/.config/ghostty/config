# ~/.config/ghostty/config:jeff
#
# user ghostty configuration
#
# SEE ALSO
# 1. https://ghostty.org/docs/config
#
# Comments start with a `#` and are only valid on their own line;
# Empty values reset the configuration to the default value;
# Blank lines are ignored!
#

auto-update = off

#background = 282c34
#foreground = ffffff

keybind = cmd+w=close_surface
# FIXME(JEFF): Invalid syntax?
#keybind = cmd+shit+o=new_split:down
#keybind = cmd+t=

font-family = "JetBrains Mono"
#font-family = "Source Code Pro"
bold-is-bright = true

#command = /bin/bash
# TODO
#command = /bin/bash ~/local/bin/tmux_init.sh default /home/jeff/Projects
# IMPORTANT(JEFF): The script we pass here must comply with the semantics of Ghostty;
# `/bin/sh -c $SHELL --posix`
#initial-command = ~/local/bin/tmux_init.sh default /home/jeff/Projects
# This is primarily useful for scripts or debugging.
#wait-after-command = true

shell-integration = bash
shell-integration-features = cursor,sudo,title

working-directory = home
window-decoration = false

quit-after-last-window-closed-delay = 10s

