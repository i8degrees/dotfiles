# ~/.config/ghostty/config:jeff
#
# user ghostty configuration
#
# SEE ALSO
# 1. https://ghostty.org/docs/config
#
# Comments start with a `#` and are only valid on their own line;
# Empty values reset the configuration to the default value;
# Blank lines are ignored!
#
# QUICK REFERENCE
# 2. ghostty +validate-config
# 3. ghostty +show-config
#
# systemd on Linux
#
# 1. systemctl enable --user app-com.mitchellh.ghostty.service
# 1. systemctl reload --user app-com.mitchellh.ghostty.service
# 1. journalctl -a -f --user -u app-com.mitchellh.ghostty.service
# 1. systemctl status --user app-com.mitchellh.ghostty.service
#

auto-update = off

#background = 282c34
#foreground = ffffff

font-family = "JetBrains Mono"
#font-family = "Source Code Pro"
bold-is-bright = true

# IMPORTANT(JEFF): We prefer to initialize Ghostty's shell integration
# features manually, via our shell init scripts. This is for preserving our
# ability to quickly jump from one shell to the next, i.e.: BASH to ZSH and 
# vice versa.
#
# 1. https://ghostty.org/docs/features/shell-integration
shell-integration = none
shell-integration-features = cursor,sudo,title

working-directory = home
# Always keep our window manager's decorations so we have access
# to its window functions menu!
window-decoration = true

# optimizations for using ghostty with systemd on Linux
# https://ghostty.org/docs/linux/systemd
quit-after-last-window-closed-delay = 15s
# IMPORTANT(JEFF): This should be enabled when using systemd to auto-start
# ghostty, except when one prefers to use a FreeDesktop entry in their 
# XDG autostart directory.
initial-window = true
#initial-window = false

# NOTE(JEFF): Do not automatically copy text upon selection; this does not
# disable middle-click paste.
copy-on-select = false

right-click-action = context-menu

mouse-hide-while-typing = true
# NOTE(JEFF): This enables standard cursor selection as seen in other
# terminal emulators --
#
# a) options + left mouse click on MacOS;
# b) ALT + left mouse click on all other OS
cursor-click-to-move = true

# store its window state, including window size, position, and
# the layout of tabs and splits
#
# WARNING(JEFF): This feature may only be supported on MacOS --
# if this is the case, our only other option may be to write a
# startup script that can aid in at least restoring our tab
# order, position and title.
window-save-state = "always"
quit-after-last-window-closed = true
# TODO(JEFF): Switch back over if window state is not restored properly...
quit-after-last-window-closed = false

# v1.2.x
#gtk-titlebar-style=tabs
# TODO(JEFF): Verify and setup
#quick-terminal-size=480x640

# WARNING(JEFF): If this external path fails to parse, the parser fails
# and stops before reaching the top-level parent!
config-file = ~/.config/ghostty/config.input

# Human Plus Plus env
config-file = ?~/.config/ghostty/themes/human-plus-plus

