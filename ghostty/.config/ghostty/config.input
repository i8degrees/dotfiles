# ~/.config/ghostty/input.conf:jeff
#
# Ghostty key bindings
#
# SEE ALSO
# 1. https://ghostty.org/docs/config/keybind/reference
#
# SEE ALSO
# 1. ~/.config/ghostty/config.defaults
# 2. iTerm2 key bindings
#
# QUICK REFERENCE
# 2. ghostty +validate-config
# 3. ghostty +show-config
#
# systemd on Linux
#
# 1. systemctl enable --user app-com.mitchellh.ghostty.service
# 1. systemctl reload --user app-com.mitchellh.ghostty.service
# 1. journalctl -a -f --user -u app-com.mitchellh.ghostty.service
# 1. systemctl status --user app-com.mitchellh.ghostty.service
#

# TODO(JEFF): Figure out how best to separate our key bindings into two
# distinct groups, based on an environmental toggle switch from file or other
# input:
#
# 1a. MacOS inspired keyboard layout
# 1b. CMD becomes the primary modifier
#
# 2a. Alternative keyboard layout
# 2b. CTRL or META becomes the primary modifier
#

# MacOS inspired key bindings
keybind = cmd+w=close_surface
#keybind = ctrl+shift+w=

keybind = cmd+t=new_tab
#keybind = ctrl+shift+t=new_tab

keybind = cmd+o=new_split:down
#keybind = ctrl+shift+o=new_split:down

keybind = cmd+]=new_split:right
#keybind = ctrl+shift+]=new_split:right

# Alternative key bindings
#keybind = ctrl+shift+t=new_tab
#keybind = ctrl+shift+w=close_surface
#keybind = ctrl+shift+o=new_split:down

# MacOS inspired key bindings
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard

# Alternative key bindings
#keybind = ctrl+shift+c=copy_to_clipboard
#keybind = ctrl+shift+v=paste_from_clipboard

# MacOS inspired key bindings
#keybind = cmd+home=scroll_to_top
#keybind = cmd+end=scroll_to_bottom

# Alternative key bindings
keybind = shift+home=scroll_to_top
keybind = shift+end=scroll_to_bottom

keybind = cmd+f=toggle_fullscreen
#keybind = ctrl+shift+f=toggle_fullscreen

# MacOS
keybind = cmd+g=toggle_tab_overview
# alt
#keybind = ctrl+shift+g=toggle_tab_overview

# !! The following key bindings only work with native tabs & windows (no tmux)
# MacOS
#keybind = cmd+s=write_scrollback_file:paste
# Alt
#keybind = ctrl+shift+s=write_scrollback_file:paste

