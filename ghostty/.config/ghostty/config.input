# ~/.config/ghostty/input.conf:jeff
#
# Ghostty key bindings
#
# SEE ALSO
# 1. https://ghostty.org/docs/config/keybind/reference
#
# Comments start with a `#` and are only valid on their own line;
# Empty values reset the configuration to the default value;
# Blank lines are ignored!
#
# SEE ALSO
# ~/.config/ghostty/config.defaults
#
# QUICK REFERENCE
# 2. ghostty +validate-config
# 3. ghostty +show-config
#
# systemd on Linux
#
# 1. systemctl enable --user app-com.mitchellh.ghostty.service
# 1. systemctl reload --user app-com.mitchellh.ghostty.service
# 1. journalctl -a -f --user -u app-com.mitchellh.ghostty.service
# 1. systemctl status --user app-com.mitchellh.ghostty.service
#

keybind = cmd+w=close_surface

