<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://freedesktop.org">
<policyconfig>

  <action id="org.local.keyboard.toggle">
    <description>Toggle Built-in Laptop Keyboard</description>
    <message>Authentication is required to toggle the internal keyboard.</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/tee</annotate>
  </action>

</policyconfig>
