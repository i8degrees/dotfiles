# TODO(JEFF): rename this file; something like
# `~/.bash/aliases.d/termux` ..?
# TODO(JEFF): integrate further into our 
# bash dotfiles?
#

# IMPORTANT(JEFF): This file has been made obsolete as of the
# git branch feature/android-bash
#USE_TERMUX_MOD=1

# Functions which I'm gonna count as aliases
getperms() {
  rootcheck && $ROOT pm get-privapp-permissions $1 | sed "s/, /\n/g"
}

getdenyperms() {
  rootcheck && $ROOT pm get-privapp-deny-permissions $1 | sed "s/, /\n/g"
}

# shellcheck disable=SC1091
[[ -n "$THOME" ]] && [[ -e "$THOME/.bash_profile" ]] && echo "Loading THOME/profile..." && . "$THOME/.bash_profile"

# EOF

if [ -n "$USE_TERMUX_MOD" ]; then
  TBIN=/data/data/com.termux/files/usr/bin; export TBIN
  THOME=/data/data/com.termux/files/home; export THOME
  SDHOME=/sdcard; export SDHOME
fi

if [ -n "$USE_TERMUX_MOD" ]; then
  alias rebash='source /sdcard/.aliases'
  alias aflinger='rootcheck && $ROOT dumpsys media.audio_flinger'
  alias bb='$BBDIR/busybox'
  alias bsu='su -s bash'
  alias dservice='rootcheck && $ROOT dumpsys media.dolby_memoryservice'
  alias killice='rootcheck && $ROOT killall dk.icepower.icesound'
  alias l='bb ls --group-directories-first'
  alias la='l -A'
  alias ll='l -l'
  alias lo='l -al'
  alias ls='ls --color=auto'
  alias nano='nano -l'
  alias killpac='rootcheck && $ROOT kill $(pidof $1)'
  alias sbash='. /system/etc/bash/bashrc'
  alias sudo='su -c "$@"'
  alias vd='cd'

  if [ "$(which vim)" ]; then
    alias vi='vim'
  else
    alias vim='vi'
  fi

  # SSH env; this always assumes android OS
  if [ "$(which mosh)" && "$(which ssh)" ]; then
    alias ssh='mosh $@'
  fi
fi


if [ -n "$USE_TERMUX_MOD" ]; then
  # TODO(JEFF): Determine if we can figure up a way of choosing which path we
  # wish to set as HOME at the time of this script execution. Perhaps something
  # like checking the current working directory..?
  HOME=$THOME
  export HOME

  PATH=$TBIN:$THOME/local/bin:$HOME/local/bin:$PATH
  TZ=America/Chicago; export TZ
  LANG=en_US.UTF-8; export LANG
  LC_TIME=C.UTF-8; export LC_TIME
fi

