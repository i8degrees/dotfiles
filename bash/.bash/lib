# Append "$1" to $PATH when non-existing
#
# 1. append_path snippet originates from Manjaro KDE's function call in
# `/etc/profile` as of circa 2024.
append_path() {
  case ":$PATH:" in
    *:"$1":*)
      # NOTE(JEFF): The path (pre)-exists; do nothing...
      true
    ;;
    *)
      PATH="${PATH:+$PATH:}$1"
    ;;
  esac

  #export PATH
}

# Check for the existence of a path that is executable.
#
# exists_exe(path = required)
#
# ...where path is a string containing the command for which
# we seek the existence of
exists_exe() {
  pathstr="$1"
  if [ -z "$pathstr" ]; then
    return 2
  fi

  if which "$pathstr" &>/dev/null; then
    echo "$pathstr" # success!
    return 0 # truthy
  else
    return 1 # err
  fi
}

